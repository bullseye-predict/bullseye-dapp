# Prediction frontend only. It reads the Neon-backed arena catalogue and its
# twelve per-agent YES/NO questions from the prediction API.
# Never put Neon URLs, private keys, or control tokens in this file.
PUBLIC_PREDICTION_API_URL=
# For local development, override this with http://127.0.0.1:8788.

# Frontend market-source tabs to expose. This filters sources only; it does not
# limit the twelve per-agent prediction questions returned for the live match.
PUBLIC_ARENA_MARKET_SOURCES=SOLANA

# Only needed by the existing wallet UI.
VITE_DYNAMIC_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# Server-side Vercel routes use these game-service origins. The overview route
# returns the Colyseus URL to the browser for spectator matchmaking, so that
# Colyseus deployment must allow the Vercel frontend origin.
SOLZ_COLYSEUS_SERVER_URL=
SOLZ_GAME_ORIGIN=https://solz.fun
SOLZ_GAME_API_ORIGIN=
# Browser Solana RPC. The wallet layer builds its Connection before any venue
# config is fetched, so it reads this rather than publicRpcUrl. Public key only -
# this is bundled into client JS and visible to every visitor.
VITE_SOLANA_RPC_ENDPOINT=