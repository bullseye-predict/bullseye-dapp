# Prediction frontend only. It reads the Neon-backed arena catalogue and its
# twelve per-agent YES/NO questions from the prediction API.
# Never put Neon URLs, private keys, or control tokens in this file.
PUBLIC_PREDICTION_API_URL=http://127.0.0.1:8788

# Only needed by the existing wallet UI.
VITE_DYNAMIC_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# The game watch page is a fixed product route, not an environment setting.
# Colyseus is not a frontend dependency: match lifecycle and roster data come
# from Neon through PUBLIC_PREDICTION_API_URL.
