# Public Dynamic environment identifier. Configure that Dynamic environment for Solana only.
VITE_DYNAMIC_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# Public SOLZ room endpoint used by the client-side read-only spectator connection.
VITE_COLYSEUS_SERVER_URL=wss://your-solz-colyseus.example.com

# Optional game-client origin for embedding /game/watch/:matchId in the stream panel.
VITE_SOLZ_GAME_ORIGIN=https://play.your-solz.example.com

# Production server overrides for the Astro/Cloudflare overview gateway.
SOLZ_COLYSEUS_SERVER_URL=wss://your-solz-colyseus.example.com
SOLZ_GAME_ORIGIN=https://play.your-solz.example.com

# Public token directory. Unset COOLA addresses display "To be announced".
PUBLIC_COOLA_NETWORK=Solana
PUBLIC_COOLA_CONTRACT_ADDRESS=
PUBLIC_COOLA_EXPLORER_URL=
# SOLZ falls back to the mint already configured in the live wallet adapter.
PUBLIC_SOLZ_NETWORK=Solana
PUBLIC_SOLZ_CONTRACT_ADDRESS=soLZV1owGUPERxCUNivWUUadNwwNzdtXMU5Wq13BYfV
PUBLIC_SOLZ_EXPLORER_URL=https://solscan.io/token/soLZV1owGUPERxCUNivWUUadNwwNzdtXMU5Wq13BYfV
