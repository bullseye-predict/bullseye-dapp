# Public Dynamic environment identifier. Configure that Dynamic environment for Solana only.
VITE_DYNAMIC_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# Public SOLZ room endpoint used by the client-side read-only spectator connection.
VITE_COLYSEUS_SERVER_URL=wss://your-solz-colyseus.example.com

# Optional game-client origin for embedding /game/watch/:matchId in the stream panel.
VITE_SOLZ_GAME_ORIGIN=https://play.your-solz.example.com

# Production server overrides for the Astro/Cloudflare overview gateway.
SOLZ_COLYSEUS_SERVER_URL=wss://your-solz-colyseus.example.com
SOLZ_GAME_ORIGIN=https://play.your-solz.example.com

# Public token directory. Unset COOLA addresses display "To be announced".
PUBLIC_COOLA_NETWORK=Solana
PUBLIC_COOLA_CONTRACT_ADDRESS=
PUBLIC_COOLA_EXPLORER_URL=
# SOLZ falls back to the mint already configured in the live wallet adapter.
PUBLIC_SOLZ_NETWORK=Solana
PUBLIC_SOLZ_CONTRACT_ADDRESS=soLZV1owGUPERxCUNivWUUadNwwNzdtXMU5Wq13BYfV
PUBLIC_SOLZ_EXPLORER_URL=https://solscan.io/token/soLZV1owGUPERxCUNivWUUadNwwNzdtXMU5Wq13BYfV

# Public URL of the separate prediction API used by /live.
PUBLIC_PREDICTION_API_URL=http://127.0.0.1:8788

# Prediction services below are server only. Elysia remains the game backend.
PREDICTION_HOST=127.0.0.1
PREDICTION_PORT=8788
PREDICTION_DATABASE_PATH=.data/prediction.sqlite
PREDICTION_AUTH_AUDIENCE=http://127.0.0.1:8788
PREDICTION_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# JSON array of explicit deployment configs; leave unset until contracts/programs exist.
# Each entry: family, venue, chainId (string), rpcUrl, settlementAddress,
# factoryAddress, oracleAddress, collateralToken, collateralDecimals, explorerUrl.
# Solana entries: family=SOLANA, venue=SOLANA, chainId (genesis hash), rpcUrl,
# programId, networkDomain (hex32), oracleAuthority, collateralToken,
# collateralDecimals, markets (PDA -> { matchId: hex32, outcomes: [{id, label}] }).
# Optional public fields: label, collateralSymbol, publicRpcUrl.
# Only publicRpcUrl is exposed to wallets; private rpcUrl is never returned to browsers.
# Each entry may include worker: { discoveryStartBlock: "0", confirmations: 2,
# relayerKeyEnv: "PREDICTION_RELAYER_KEY", maxGas: "500000",
# maxGasPriceWei: "100000000000" }. Solana worker can name oracleKeyEnv,
# computeUnitLimit and priorityFeeMicroLamports instead of EVM gas settings.
# Discovery must include deployment history for complete position cost accounting.
PREDICTION_VENUES_FILE=
# Separate worker uses the same SQLite path as API. Read-only by default.
PREDICTION_CHAIN_WRITES=0
PREDICTION_CHAIN_INTERVAL_MS=1000
# Independent high-entropy secrets, at least 32 characters each.
PREDICTION_TELEMETRY_SECRET=
PREDICTION_CONTROL_TOKEN=
# JSON config for read-only Colyseus room mappings, field paths and result allowlists.
PREDICTION_TELEMETRY_WORKER_FILE=
# JSON config for authorized Hermes vaults, immutable policy caps and HTTPS reasoner.
# Session keys and reasoner token are environment references inside that file.
# API reads policy configuration; only the separate Hermes worker reads signing keys.
PREDICTION_HERMES_FILE=
