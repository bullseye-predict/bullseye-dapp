    "@dynamic-labs-sdk/client": "1.27.1",
    "@dynamic-labs-sdk/react-hooks": "1.27.1",
    "@dynamic-labs-sdk/solana": "1.27.1",
    "@dynamic-labs/ethereum": "5.6.1",
    "@dynamic-labs/sdk-react-core": "5.6.1",
    "@dynamic-labs/solana": "5.6.1",
    "@dynamic-labs/solana-core": "5.6.1",
    "@meteora-ag/cp-amm-sdk": "1.4.8",
    "@pmndrs/detect-gpu": "^6.0.22",
    "@scure/base": "1.2.6",
    "@solana/compat": "^8.3.0",
