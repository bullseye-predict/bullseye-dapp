    "@types/react-dom": "^19.2.5",
    "@wallet-standard/app": "1.0.1",
    "@wallet-standard/base": "1.0.1",
    "@wallet-standard/features": "1.0.3",
    "animejs": "^4.5.0",
    "astro": "^7.2.10",
    "bn.js": "5.2.5",
    "buffer": "6.0.3",
    "colyseus.js": "^0.16.22",
    "lucide-react": "1.39.0",
