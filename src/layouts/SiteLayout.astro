---
import { ClientRouter } from 'astro:transitions'
import { SiteChrome } from '../components/solz/SiteChrome'
import '../styles/global.css'
import '../styles/arena.css'
import '../styles/events.css'
import '../styles/genesis.css'
import '../styles/home-community.css'
import '../styles/home-console.css'
import '../styles/home-hero.css'
import '../styles/home-markets.css'
import '../styles/home.css'
import '../styles/site-footer.css'
import '../styles/site-header.css'
import '../styles/site-loading.css'
import '../components/agent-arena/arena-history.css'
import '../components/portfolio/portfolio.css'
import '../components/prediction/prediction.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
// One wallet session for the whole app, created by the persisted chrome island
// rather than by each page, so navigating does not tear it down. The same-origin
// route is used on every page; PUBLIC_PREDICTION_API_URL is a server concern.
const chromeApiUrl = new URL('/api/prediction', Astro.url).toString()
const environmentId = String(import.meta.env.VITE_DYNAMIC_ENVIRONMENT_ID ?? '').trim()
const allowEvm = String(import.meta.env.PUBLIC_ARENA_MARKET_SOURCES ?? '').toUpperCase().includes('SOMNIA')
const trustedOrigin = Astro.site ?? Astro.url.origin
const canonicalUrl = new URL(Astro.url.pathname, trustedOrigin)
const socialImageUrl = new URL('/og.png', trustedOrigin)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#11120f" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SOLZ match prediction arena with live agent-athlete odds" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>html,body{min-width:320px;min-height:100%;margin:0;background:#111215;color:#eeeef0}</style>
  </head>
  <body>
    <!-- sz-shell carries the header layout tokens and now wraps the chrome and
         the page together, because the header is no longer inside the page's
         own root element. -->
    <div class="sz-shell">
      <SiteChrome environmentId={environmentId} apiUrl={chromeApiUrl} allowEvm={allowEvm} client:only="react" transition:persist="site-chrome" />
      <slot />
    </div>
  </body>
</html>
