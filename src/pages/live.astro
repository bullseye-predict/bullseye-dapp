---
import { PredictionApp } from '../components/prediction/TradingEntrypoints'
import SiteLayout from '../layouts/SiteLayout.astro'
const apiUrl = new URL('/api/prediction', Astro.url).toString()
---

<SiteLayout title="Live Arena · SOLZ / ODDS" description="Trade match outcomes on Solana with Manifest or Somnia with DreamDEX Event Contracts.">
  <PredictionApp environmentId={String(import.meta.env.VITE_DYNAMIC_ENVIRONMENT_ID ?? '').trim()} apiUrl={apiUrl} client:only="react" />
</SiteLayout>
