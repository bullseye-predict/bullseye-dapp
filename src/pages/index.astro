---
import { HomeApp } from '../components/prediction/TradingEntrypoints'
import type { MarketSource } from '../components/home/MarketSourceControls'
import SiteLayout from '../layouts/SiteLayout.astro'

const validSources = new Set(['SIMULATION', 'SOLANA', 'SOMNIA'])
const configuredSources: MarketSource[] = String(import.meta.env.PUBLIC_ARENA_MARKET_SOURCES ?? 'SIMULATION,SOLANA,SOMNIA')
  .split(',')
  .map((value) => value.trim().toUpperCase())
  .filter((value): value is 'SIMULATION' | 'SOLANA' | 'SOMNIA' => validSources.has(value))
const marketSources: MarketSource[] = configuredSources.length ? configuredSources : ['SIMULATION']
// The embedded broadcast must follow the same configured game host as the
// per-match links. Keeping this at the host boundary prevents local market
// development from silently displaying a production arena.
const gameOrigin = String(import.meta.env.SOLZ_GAME_ORIGIN ?? '').trim().replace(/\/+$/, '')
// The highlight is the MIAW PRIX programme, which Agent Colosseum broadcasts.
// Agent Arena is the separate free-for-all show on its own route; pointing the
// hero at it would stream twelve agents beside a two-coin market.
// `back=false` is added by arenaEmbedUrl(), so the embed and this link stay one
// URL with one rule.
const arenaWatchUrl = gameOrigin ? `${gameOrigin}/watch/live/agent-colosseum` : ''
// Delivery must be HTTPS when this site is served over HTTPS. Keep the value
// at the Astro host boundary so the React feature stays portable; configure it
// only after an HTTPS delivery endpoint exists.
const livestreamUrl = String(import.meta.env.PUBLIC_LIVESTREAM_HLS_URL ?? '').trim()
// Browser HTTP traffic uses a stable same-origin route. The server route reads
// PUBLIC_PREDICTION_API_URL and has the deployed Railway service as a fallback.
const apiUrl = new URL('/api/prediction', Astro.url).toString()
---

<SiteLayout title="ColaCat · Cola Credits for Agent Thinking" description="Cola Credits for Agent Thinking — watch Genesis agents compete, predict the outcome, and direct the action.">
  <HomeApp dreamDexApiUrl={apiUrl} apiUrl={apiUrl} demoHref="/demo" liveHref={arenaWatchUrl} livestreamUrl={livestreamUrl} eventBasePath="/events" marketSources={marketSources} client:only="react" />
</SiteLayout>
