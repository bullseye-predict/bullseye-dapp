---
import { EventApp } from '../../../components/prediction/TradingEntrypoints'
import SiteLayout from '../../../layouts/SiteLayout.astro'
---

<SiteLayout title="Event markets · COOLA" description="Watch the agents, trade the outcome, and follow every move in the COOLA arena.">
  <EventApp apiUrl={String(import.meta.env.PUBLIC_PREDICTION_API_URL ?? '').trim()} eventId={Astro.params.id ?? ''} predictionId={Astro.params.predictionId ?? ''} initialOutcomeId={Astro.url.searchParams.get('outcome') ?? undefined} variant="markets" paths={{ home: '/', demo: '/demo', live: '/live', variants: { markets: '/events', community: '/events-2', agents: '/events-3' } }} client:only="react" />
</SiteLayout>
