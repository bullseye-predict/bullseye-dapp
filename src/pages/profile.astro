---
import { PortfolioApp } from '../components/prediction/TradingEntrypoints'
import SiteLayout from '../layouts/SiteLayout.astro'
const apiUrl = String(import.meta.env.PUBLIC_PREDICTION_API_URL ?? '').trim()
---
<SiteLayout title="Portfolio · COOLA" description="Manage your active predictions, closed positions, and available payouts.">
  <PortfolioApp matchApiUrl="/api/agent-arena" apiUrl={apiUrl} client:only="react" />
</SiteLayout>
