---
import { MarketsDirectoryApp } from '../components/prediction/TradingEntrypoints'
import SiteLayout from '../layouts/SiteLayout.astro'

const apiUrl = new URL('/api/prediction', Astro.url).toString()
---

<SiteLayout title="All match markets · ColaCat" description="Browse live, upcoming, and settled ColaCat arena markets.">
  <MarketsDirectoryApp apiUrl={apiUrl} client:only="react" />
</SiteLayout>
